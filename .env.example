# Catalog of every environment variable used by the infrastructure scripts and the ingestion
# units. Names only: no values, no placeholders that look like real secrets.
#
# Copy to .env for local use (git-ignored). On the VPS the same names go into
# /etc/smartcart/ingest.env (mode 0640, root:smartcart). In GitHub Actions they are repository
# or environment secrets. Never commit real values. See docs/infra-provisioning.md.

# --- Database (Supabase Postgres) --------------------------------------------------------------
# Ingest role, pooled or direct per docs/infra-provisioning.md section 3. Used by smartcart-ingest.
DATABASE_URL=
# Direct (non-pooled) connection for migrations and infra/smoke/db_smoke.sql.
DATABASE_URL_DIRECT=
# Read-only role for the internal dashboard.
DATABASE_URL_READONLY=

# --- Object storage for the raw archive (Cloudflare R2 or AWS S3) -------------------------------
# R2 needs the endpoint URL; leave it empty for AWS S3. R2 region is "auto".
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# infra/smoke/bucket_roundtrip.py only.
S3_KEY_PREFIX=
SMOKE_REQUIRE_DELETE=

# --- VPS setup and smoke scripts (infra/vps/setup.sh, infra/smoke/*.sh) -----------------------
SMARTCART_REPO_URL=
SMARTCART_REPO_REF=
SMARTCART_SKIP_CLONE=
SMARTCART_SSH_PORT=
SMARTCART_SKIP_HARDENING=
# Override the CLI arguments of the systemd units (defaults are in the unit files).
SMARTCART_INGEST_FULL_ARGS=
SMARTCART_INGEST_DELTA_ARGS=
# check_israeli_ip.sh and check_portals.sh.
GEO_URL_1=
GEO_URL_2=
IP_URL=
CURL_MAX_TIME=
PROBE_EDI=
SKIP_DOWNLOAD_PROBE=

# --- Terraform skeleton (infra/terraform), read as TF_VAR_<name> -------------------------------
TF_VAR_supabase_access_token=
TF_VAR_supabase_organization_id=
TF_VAR_supabase_database_password=
TF_VAR_cloudflare_api_token=
TF_VAR_cloudflare_account_id=
TF_VAR_kamatera_api_client_id=
TF_VAR_kamatera_api_secret=
TF_VAR_ssh_public_key=

# --- ingestion runtime (services/ingest, see docs/ingestion.md) ---
# Local raw-file archive directory; leave empty to use the S3_* bucket above.
RAW_STORE_PATH=
# Optional webhook that receives alerts (parse failures, quarantines, portal backoff cap).
ALERT_WEBHOOK_URL=
# Quality gate thresholds (defaults shown).
STALE_FILE_MAX_AGE_HOURS=36
PRICE_JUMP_FACTOR=3
ITEM_COUNT_DROP_RATIO=0.5
# Per-chain overrides as JSON, e.g. {"7290027600007": {"item_count_drop_ratio": 0.3}}
QUALITY_OVERRIDES=
# Per-chain delta polling interval in minutes as JSON, e.g. {"7290058140886": 30}
DELTA_INTERVAL_MINUTES=
# Portal retry policy.
PORTAL_MAX_ATTEMPTS=5
PORTAL_BACKOFF_BASE_SECONDS=30
PORTAL_BACKOFF_CAP_SECONDS=1800

# Catalog and API runtime (phase 1)
ANTHROPIC_API_KEY=
EXTRACTOR=rule
EXTRACTION_MODEL=claude-sonnet-5-5
EMBEDDER=hash
EMBEDDING_MODEL=BAAI/bge-m3
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- phase 2: web push, Supabase admin and auth, beta flags ---
# Server side (services/api). Generate VAPID keys once: `uv run python -c "from py_vapid import Vapid; v=Vapid(); v.generate_keys(); print(v.private_pem().decode()); print(v.public_key_urlsafe_base64())"`
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
# Web (build time)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_BETA_EVENTS=
NEXT_PUBLIC_API_MOCK=
