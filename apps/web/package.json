{
  "name": "@smartcart/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev",
    "dev:mock": "NEXT_PUBLIC_API_MOCK=1 next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0 && stylelint \"src/**/*.css\"",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "a11y": "playwright test -c playwright.a11y.config.ts",
    "gen:api": "openapi-typescript src/api/openapi.json -o src/api/types.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"*.{ts,mjs}\" scripts",
    "fetch:fonts": "bash scripts/fetch-heebo.sh",
    "lhci": "npx -y @lhci/cli@0.15.1 autorun"
  },
  "dependencies": {
    "msw": "3.0.2",
    "next": "16.4.0",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.56.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.13.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "jsdom": "29.1.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.9",
    "stylelint": "17.16.0",
    "typescript": "5.9.3",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
