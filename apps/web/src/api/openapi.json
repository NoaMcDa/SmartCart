    "schemas": {
      "Ack": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Id"
          },
          "ok": {
            "default": true,
            "title": "Ok",
            "type": "boolean"
          }
        },
        "title": "Ack",
        "type": "object"
      },
      "AttributeTag": {
        "additionalProperties": false,
        "properties": {
          "key": {
            "title": "Key",
            "type": "string"
          },
          "status": {
            "enum": [
              "matched",
              "differs",
              "unverified"
            ],
            "title": "Status",
            "type": "string"
          },
          "value": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value"
          }
        },
        "required": [
          "key",
          "status"
        ],
        "title": "AttributeTag",
        "type": "object"
      },
      "BasketItem": {
        "additionalProperties": false,
        "properties": {
          "canonical_id": {
            "title": "Canonical Id",
            "type": "integer"
          },
          "exact_item_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Required when flex_level is exact",
            "title": "Exact Item Id"
          },
          "flex_level": {
            "default": "any_brand",
            "enum": [
              "exact",
              "any_brand",
              "close"
            ],
            "title": "Flex Level",
            "type": "string"
          },
          "quantity": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ],
            "title": "Quantity"
          }
        },
        "required": [
          "canonical_id",
          "quantity"
        ],
        "title": "BasketItem",
        "type": "object"
      },
      "CanonicalRef": {
        "additionalProperties": false,
        "properties": {
          "base_unit": {
            "enum": [
              "100g",
              "100ml",
              "unit",
              "kg"
            ],
            "title": "Base Unit",
            "type": "string"
          },
          "canonical_id": {
            "title": "Canonical Id",
            "type": "integer"
          },
          "display_name_he": {
            "title": "Display Name He",
            "type": "string"
          },
          "taxonomy_id": {
            "title": "Taxonomy Id",
            "type": "string"
          }
        },
        "required": [
          "canonical_id",
          "display_name_he",
          "taxonomy_id",
          "base_unit"
        ],
        "title": "CanonicalRef",
        "type": "object"
      },
      "CompareRequest": {
        "additionalProperties": false,
        "properties": {
          "clubs": {
            "items": {
              "type": "string"
            },
            "title": "Clubs",
            "type": "array"
          },
          "home_store_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "The user's usual store; savings are measured against it only",
            "title": "Home Store Id"
          },
          "include_online": {
            "default": false,
            "title": "Include Online",
            "type": "boolean"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/BasketItem"
            },
            "maxItems": 200,
            "minItems": 1,
            "title": "Items",
            "type": "array"
          },
          "location": {
            "$ref": "#/components/schemas/Location"
          }
        },
        "required": [
          "items",
          "location"
        ],
        "title": "CompareRequest",
        "type": "object"
      },
      "CompareResponse": {
        "additionalProperties": false,
        "properties": {
          "disclaimer_he": {
            "default": "המחיר הקובע הוא בקופה.",
            "title": "Disclaimer He",
            "type": "string"
          },
          "generated_at": {
            "format": "date-time",
            "title": "Generated At",
            "type": "string"
          },
          "home_store_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Home Store Id"
          },
          "home_store_total": {
            "anyOf": [
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Home Store Total"
          },
          "stores": {
            "description": "Sorted: complete baskets first, then by total",
            "items": {
              "$ref": "#/components/schemas/StoreResult"
            },
            "title": "Stores",
            "type": "array"
          }
        },
        "required": [
          "stores",
          "home_store_id",
          "home_store_total",
          "generated_at"
        ],
        "title": "CompareResponse",
        "type": "object"
      },
      "GapReportRequest": {
        "additionalProperties": false,
        "properties": {
          "actual_price": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Actual Price"
          },
          "canonical_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Canonical Id"
          },
          "item_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Item Id"
          },
          "note": {
            "anyOf": [
              {
                "maxLength": 500,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          },
          "shown_price": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Shown Price"
          },
          "store_id": {
            "title": "Store Id",
            "type": "integer"
          }
        },
        "required": [
          "store_id"
        ],
        "title": "GapReportRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Health": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "version"
        ],
        "title": "Health",
        "type": "object"
      },
      "Location": {
        "additionalProperties": false,
        "properties": {
          "lat": {
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Lat",
            "type": "number"
          },
          "lon": {
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "Lon",
            "type": "number"
          },
          "radius_m": {
            "default": 5000,
            "maximum": 15000.0,
            "minimum": 500.0,
            "title": "Radius M",
            "type": "integer"
          }
        },
        "required": [
          "lon",
          "lat"
        ],
        "title": "Location",
        "type": "object"
      },
      "OptimizeRequest": {
        "additionalProperties": false,
        "properties": {
          "clubs": {
            "items": {
              "type": "string"
            },
            "title": "Clubs",
            "type": "array"
          },
          "home_store_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "The user's usual store; savings are measured against it only",
            "title": "Home Store Id"
          },
          "include_online": {
            "default": false,
            "title": "Include Online",
            "type": "boolean"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/BasketItem"
            },
            "maxItems": 200,
            "minItems": 1,
            "title": "Items",
            "type": "array"
          },
          "location": {
            "$ref": "#/components/schemas/Location"
          },
          "max_stores": {
            "default": 2,
            "maximum": 3.0,
            "minimum": 1.0,
            "title": "Max Stores",
            "type": "integer"
          },
          "min_split_saving": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ],
            "default": "25",
            "description": "A split is recommended only above this net saving",
            "title": "Min Split Saving"
          },
          "travel": {
            "$ref": "#/components/schemas/TravelSettings"
          }
        },
        "required": [
          "items",
          "location"
        ],
        "title": "OptimizeRequest",
        "type": "object"
      },
      "OptimizeResponse": {
        "additionalProperties": false,
        "properties": {
          "disclaimer_he": {
            "default": "המחיר הקובע הוא בקופה.",
            "title": "Disclaimer He",
            "type": "string"
          },
          "generated_at": {
            "format": "date-time",
            "title": "Generated At",
            "type": "string"
          },
          "minimum_effort": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Plan"
              },
              {
                "type": "null"
              }
            ],
            "description": "The home store itself; null without a home store"
          },
          "single": {
            "$ref": "#/components/schemas/Plan"
          },
          "split": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Plan"
              },
              {
                "type": "null"
              }
            ],
            "description": "null when no split beats min_split_saving"
          },
          "subsets_evaluated": {
            "title": "Subsets Evaluated",
            "type": "integer"
          }
        },
        "required": [
          "single",
          "subsets_evaluated",
          "generated_at"
        ],
        "title": "OptimizeResponse",
        "type": "object"
      },
      "ParseListRequest": {
        "additionalProperties": false,
        "properties": {
          "flex_defaults": {
            "additionalProperties": {
              "enum": [
                "exact",
                "any_brand",
                "close"
              ],
              "type": "string"
            },
            "description": "taxonomy_id -> flex level",
            "title": "Flex Defaults",
            "type": "object"
          },
          "text": {
            "description": "Free text, Hebrew, comma or newline separated",
