            "minLength": 1,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "title": "ParseListRequest",
        "type": "object"
      },
      "ParseListResponse": {
        "additionalProperties": false,
        "properties": {
          "generated_at": {
            "format": "date-time",
            "title": "Generated At",
            "type": "string"
          },
          "rows": {
            "items": {
              "$ref": "#/components/schemas/ParsedRow"
            },
            "title": "Rows",
            "type": "array"
          }
        },
        "required": [
          "rows",
          "generated_at"
        ],
        "title": "ParseListResponse",
        "type": "object"
      },
      "ParsedRow": {
        "additionalProperties": false,
        "properties": {
          "candidates": {
            "description": "Alternatives when confidence is low",
            "items": {
              "$ref": "#/components/schemas/CanonicalRef"
            },
            "title": "Candidates",
            "type": "array"
          },
          "canonical": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CanonicalRef"
              },
              {
                "type": "null"
              }
            ]
          },
          "confidence": {
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence",
            "type": "number"
          },
          "flex_level": {
            "default": "any_brand",
            "enum": [
              "exact",
              "any_brand",
              "close"
            ],
            "title": "Flex Level",
            "type": "string"
          },
          "input_text": {
            "title": "Input Text",
            "type": "string"
          },
          "is_weighed": {
            "default": false,
            "title": "Is Weighed",
            "type": "boolean"
          },
          "needs_confirmation": {
            "title": "Needs Confirmation",
            "type": "boolean"
          },
          "not_found": {
            "default": false,
            "title": "Not Found",
            "type": "boolean"
          },
          "quantity": {
            "default": "1",
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Quantity",
            "type": "string"
          }
        },
        "required": [
          "input_text",
          "confidence",
          "needs_confirmation"
        ],
        "title": "ParsedRow",
        "type": "object"
      },
      "Plan": {
        "additionalProperties": false,
        "properties": {
          "breakdown": {
