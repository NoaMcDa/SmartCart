          "store_name",
          "distance_m",
          "channel",
          "total",
          "found_count",
          "missing",
          "substituted_count",
          "items",
          "prices_updated_at"
        ],
        "title": "StoreResult",
        "type": "object"
      },
      "SubstitutionFeedbackRequest": {
        "additionalProperties": false,
        "properties": {
          "canonical_id": {
            "title": "Canonical Id",
            "type": "integer"
          },
          "original_item_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Original Item Id"
          },
          "substitute_item_id": {
            "title": "Substitute Item Id",
            "type": "integer"
          },
          "verdict": {
            "enum": [
              "not_good",
              "kept_original",
              "accepted"
            ],
            "title": "Verdict",
            "type": "string"
          }
        },
        "required": [
          "canonical_id",
          "substitute_item_id",
          "verdict"
        ],
        "title": "SubstitutionFeedbackRequest",
        "type": "object"
      },
      "TravelSettings": {
        "additionalProperties": false,
        "properties": {
          "cost_per_km": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ],
            "default": "1.2",
            "title": "Cost Per Km"
          },
          "extra_stop_value": {
            "anyOf": [
              {
                "maximum": 50.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ],
            "default": "25",
            "description": "What one more stop is worth to the user, ILS",
            "title": "Extra Stop Value"
          },
          "mode": {
            "default": "car",
            "enum": [
              "car",
              "walk_transit",
              "delivery"
            ],
            "title": "Mode",
            "type": "string"
          }
        },
        "title": "TravelSettings",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
