              "minimum_effort"
            ],
            "title": "Kind",
            "type": "string"
          },
          "missing": {
            "items": {
              "type": "integer"
            },
            "title": "Missing",
            "type": "array"
          },
          "recommended": {
            "title": "Recommended",
            "type": "boolean"
          },
          "stores": {
            "items": {
              "$ref": "#/components/schemas/StoreAssignment"
            },
            "title": "Stores",
            "type": "array"
          },
          "substituted_count": {
            "default": 0,
            "title": "Substituted Count",
            "type": "integer"
          },
          "total": {
            "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
            "title": "Total",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "stores",
          "total",
          "recommended"
        ],
        "title": "Plan",
        "type": "object"
      },
